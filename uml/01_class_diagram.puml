@startuml 01_class_diagram
title MARS-OPS - Class Diagram

' ---- Plain & Wide Spacing Settings ----
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

' زيادة التباعد الأفقي والرأسي بشكل كبير
skinparam nodesep 150
skinparam ranksep 150
skinparam packagePadding 40

package agents {
  interface Repairable {
    + isDamaged() : boolean
    + repair()
  }

  enum Capability {
    SCIENTIFIC_RESEARCH
    ENGINEERING_REPAIR
    ROBOTIC_REPAIR
    MEDICAL_CARE
    FIRE_RESPONSE
    SURFACE_TRAVEL
    AERIAL_RECON
  }

  enum HealthStatus {
    HEALTHY
    INJURED
    CRITICAL
  }

  enum DamageStatus {
    OPERATIONAL
    DAMAGED
  }

  abstract class AbstractAgent {
    - id : String
    - name : String
    - busy : boolean
    - location : Location
    - capabilities : Set<Capability>
    + canPerform(mission : Mission) : boolean
    + canHandle(emergency : Emergency) : boolean
    + isAvailable() : boolean
    + getOperationalProblem() : String
    + {abstract} advanceTime()
  }

  abstract class CrewMember {
    - health : int
    - fatigue : int
    + performDuty()
    + heal(amount : int)
    + reduceHealth(amount : int)
    + receiveTreatment(amount : int)
    + getHealthStatus() : HealthStatus
  }

  abstract class Robot {
    - battery : int
    - damageStatus : DamageStatus
    + drainBattery(amount : int)
    + recharge(amount : int)
    + markDamaged()
    + repair()
    + {abstract} getBatteryDrainPerUnit() : int
    + {abstract} getBatteryrechargePerUnit() : int
  }

  class Scientist {
    + performDuty()
  }

  class Engineer {
    + performDuty()
  }

  class MedicalOfficer {
    + performDuty()
  }

  class ExplorationRover {
    + getEnvironmentRestriction(env : Environment) : String
  }

  class Drone {
    + getEnvironmentRestriction(env : Environment) : String
  }

  class RepairRobot
}

package colony {
  interface Location {
    + getName() : String
    + isOperational() : boolean
    + isSheltered() : boolean
  }

  class SurfaceLocation

  class OperationResult {
    - success : boolean
    - message : String
    + {static} success(msg : String) : OperationResult
    + {static} failure(reason : String) : OperationResult
  }

  class Reacordingevents {
    - entries : List<String>
    + record(time : int, message : String)
  }

  class MarsColony {
    - name : String
    - currentTime : int
    - activeMission : Mission
    - missionHistory : List<Mission>
    + addCrewMember(member : CrewMember)
    + addRobot(robot : Robot)
    + addFacility(facility : Facilities)
    + submitMission(m : Mission, agents : List<AbstractAgent>) : OperationResult
    + advanceTime(units : int)
    + activateCondition(c : EnvironmentCondition)
    + reevaluateActiveMission()
  }
}

package environment {
  enum EnvironmentCondition {
    NORMAL
    DUST_STORM
    COMMUNICATION_DISRUPTION
  }

  class Environment {
    - active : Set<EnvironmentCondition>
    + activate(c : EnvironmentCondition)
    + deactivate(c : EnvironmentCondition)
    + isDustStorm() : boolean
    + isCommunicationDisrupted() : boolean
  }
}

package "Facilities" as Facilities_pkg {
  abstract class Facilities {
    - name : String
    - capacity : int
    - isOperational : boolean
    - isSheltered : boolean
    + addresource(type : ResourceType, qty : int)
    + consumeresource(type : ResourceType, qty : int) : boolean
    + addEquipment(e : Equipment)
    + findAvailableEquipment(t : EquipmentType) : Equipment
  }

  class Laboratory
  class habitat {
    - oxygenLeakActive : boolean
    + startOxygenLeak()
    + repairOxygenLeak()
    + removeOxygen(amount : int) : boolean
  }
  class powerstation
  class Storagefacilities
  class communicationstation
}

package resources {
  enum ResourceType {
    OXYGEN
    WATER
    FOOD
    FUEL
    BATTERY_POWER
    MEDICAL_SUPPLIES
    SPARE_PARTS
  }

  enum EquipmentType {
    SCIENTIFIC
    EXPLORATION
    REPAIR_TOOLS
    MEDICAL
    COMMUNICATION
  }

  class Resources {
    - amounts : Map<ResourceType, Integer>
    + getQuantity(t : ResourceType) : int
    + addQuantity(t : ResourceType, n : int)
    + findShortage(req : Resources) : String
    + canSupply(req : Resources) : boolean
    + consume(req : Resources) : boolean
  }

  class Equipment {
    - id : String
    - name : String
    - type : EquipmentType
    - damaged : boolean
    - inUse : boolean
    + damage()
    + repair()
    + isAvailableForUse() : boolean
  }
}

package missions {
  enum MissionStatus {
    CREATED
    ASSIGNED
    IN_PROGRESS
    COMPLETED
    FAILED
  }

  abstract class Mission {
    - id : String
    - name : String
    - duration : int
    - timepassed : int
    - status : MissionStatus
    - failureReason : String
    - assignedAgents : List<AbstractAgent>
    + validateTeam(agents : List<AbstractAgent>) : String
    + assign(agents : List<AbstractAgent>, colony : MarsColony)
    + start(colony : MarsColony)
    + advance(colony : MarsColony)
    + fail(reason : String)
    + release()
    + {abstract} getRequiredCapabilities() : List<Capability>
    + {abstract} getResourceRequirement() : Resources
  }

  class ExplorationMission {
    - region : String
    - equipment : Equipment
  }

  class ResearchMission {
    - laboratory : Laboratory
    - equipment : Equipment
  }

  class RepairMission {
    - target : Repairable
  }

  class RescueMission {
    - stranded : AbstractAgent
    - destination : Facilities
  }
}

package emergencies {
  enum EmergencyStatus {
    PENDING
    ACTIVE
    RESOLVED
    UNRESOLVED
  }

  abstract class Emergency {
    - id : String
    - description : String
    - status : EmergencyStatus
    - unresolvedReason : String
    - responders : List<AbstractAgent>
    + {final} handle(colony : MarsColony) : OperationResult
    + {abstract} getRequiredResponders() : List<Capability>
    # {abstract} getResponseResources() : Resources
    # {abstract} onDetected(colony : MarsColony)
    # {abstract} onResolved(colony : MarsColony)
    # {abstract} onUnresolved(colony : MarsColony)
  }

  class OxygenLeak {
    - oxygenLoss : int
    - totalOxygenLost : int
  }

  class Fire
  class MedicalEmergency {
    - healthLoss : int
  }

  class RoverBreakdown

  class EmergencyManager {
    - status : Status
    - lastReason : String
    + handleOxygenLeak(id : String, h : habitat, loss : int, parts : int, ok : boolean) : Status
  }
}

' ---- Inheritance / Realization ----
AbstractAgent <|-- CrewMember
AbstractAgent <|-- Robot

CrewMember <|-- Scientist
CrewMember <|-- Engineer
CrewMember <|-- MedicalOfficer

Robot <|-- ExplorationRover
Robot <|-- Drone
Robot <|-- RepairRobot
Robot ..|> Repairable

Location <|.. SurfaceLocation
Location <|.. Facilities

Facilities <|-- Laboratory
Facilities <|-- habitat
Facilities <|-- powerstation
Facilities <|-- Storagefacilities
Facilities <|-- communicationstation

Mission <|-- ExplorationMission
Mission <|-- ResearchMission
Mission <|-- RepairMission
Mission <|-- RescueMission

Emergency <|-- OxygenLeak
Emergency <|-- Fire
Emergency <|-- MedicalEmergency
Emergency <|-- RoverBreakdown

' ---- Composition / Aggregation ----
MarsColony "1" *-- "1" Environment
MarsColony "1" *-- "1" Reacordingevents
MarsColony "1" *-- "1" Resources
MarsColony "1" o-- "0..*" CrewMember
MarsColony "1" o-- "0..*" Robot
MarsColony "1" o-- "0..*" Facilities
MarsColony "1" o-- "0..*" Mission

Facilities "1" *-- "0..*" Equipment
Resources "1" o-- "0..*" Facilities

Mission "1" o-- "1..*" AbstractAgent : assignedAgents
Emergency "1" o-- "0..*" AbstractAgent : responders

' ---- Associations ----
AbstractAgent "*" -down-> "1" Location : location
AbstractAgent -right-> "1..*" Capability
CrewMember ..> HealthStatus
Robot -down-> DamageStatus
Equipment -right-> EquipmentType
Environment -right-> EnvironmentCondition
Mission -right-> MissionStatus
Emergency -right-> EmergencyStatus

ExplorationMission --> Equipment
ResearchMission --> Laboratory
ResearchMission --> Equipment
RepairMission --> Repairable
RescueMission --> AbstractAgent : stranded
RescueMission --> Facilities : destination

OxygenLeak --> habitat
Fire --> Laboratory
MedicalEmergency --> CrewMember : patient
RoverBreakdown --> ExplorationRover

' ---- Dependencies ----
MarsColony ..> OperationResult
Mission ..> Resources
Resources ..> ResourceType
Emergency ..> MarsColony

@enduml