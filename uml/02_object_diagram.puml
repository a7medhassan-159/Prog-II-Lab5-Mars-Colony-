@startuml 02_object_diagram
title MARS-OPS - Object Diagram (Scenario 1 after submitMission)
skinparam shadowing false

object "ares : MarsColony" as ares {
  name = "Ares Base"
  currentTime = 0
}
object "env : Environment" as env {
  active = {}
}
object "log : Reacordingevents" as log {
  entries = ["Mission submitted: EX-1", ...]
}
object "res : Resources" as res {
  WATER = 50
  BATTERY_POWER = 50
  FUEL = 10
  SPARE_PARTS = 10
  OXYGEN = 100
}
object "lab : Laboratory" as lab {
  name = "Central Lab"
  capacity = 10
  isOperational = true
}
object "power : powerstation" as power {
  name = "Solar Power Station"
  capacity = 20
}
object "storage : Storagefacilities" as storage {
  name = "Main Storage"
  capacity = 50
}
object "hab : habitat" as hab {
  name = "Main Habitat"
  oxygenLeakActive = false
}
object "eq1 : Equipment" as eq1 {
  id = "EQ-01"
  type = SCIENTIFIC
  inUse = false
}
object "eq2 : Equipment" as eq2 {
  id = "EQ-02"
  type = EXPLORATION
  inUse = true
}
object "dr_sarah : Scientist" as sarah {
  id = "C-01"
  name = "Dr. Sarah"
  health = 100
  busy = true
}
object "eng_alex : Engineer" as alex {
  id = "C-02"
  name = "Eng. Alex"
  health = 100
  busy = false
}
object "rover_alpha : ExplorationRover" as rover {
  id = "R-01"
  name = "Rover Alpha"
  battery = 100
  busy = true
}
object "repair_bot : RepairRobot" as bot {
  id = "R-02"
  name = "Repair Robot"
  battery = 100
  busy = false
}
object "ex1 : ExplorationMission" as ex1 {
  id = "EX-1"
  region = "Olympus Mons"
  duration = 5
  timepassed = 0
  status = ASSIGNED
}

ares *-- env
ares *-- log
ares *-- res
ares o-- lab
ares o-- power
ares o-- storage
ares o-- hab
ares o-- sarah
ares o-- alex
ares o-- rover
ares o-- bot
ares --> ex1 : activeMission
lab *-- eq1
lab *-- eq2
ex1 --> sarah : assignedAgents
ex1 --> rover : assignedAgents
ex1 --> eq2 : equipment
sarah ..> lab : location
alex ..> lab : location
rover ..> lab : location
bot ..> lab : location
@enduml
