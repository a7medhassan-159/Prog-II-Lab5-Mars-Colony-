@startuml 04b_sequence_mission_rejection
title Sequence Diagram 2 - Mission Rejection, Unsuitable Agent (Scenario 2)
skinparam shadowing false
autonumber

actor Main
participant "MarsColony" as C
participant "bad : ResearchMission" as M
participant "engineer : Engineer" as E

Main -> C : submitMission(bad, [engineer])
activate C
C -> C : validateSubmission()
C -> M : validateTeam([engineer])
activate M
M -> E : canPerform(bad)
E --> M : false
M --> C : reason (team lacks required capability)
deactivate M
C -> M : fail(reason)
note right of M : status = FAILED\nnever becomes active\nno resources consumed
C -> C : missionHistory.add(bad)
C --> Main : OperationResult.failure(reason)
deactivate C
@enduml
